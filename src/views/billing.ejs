<!-- views/admin/top-buyers.ejs -->
<%- include('./includes/header') %>

<link rel="stylesheet" href="/css/dashboard.css" />
<link rel="stylesheet" href="/css/billing.css" />
<link rel="stylesheet" href="/css/common.css" />

<body class="dashboard-page">
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <%- include('./includes/side-bar') %>

    <!-- Main Content -->
    <div class="dashboard-content">
      <!-- Navbar -->
      <%- include('./includes/navbar') %>

      <h2 class="billing-heading">Top Buyers Leaderboard</h2>

      <table class="top-buyers-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Member</th>
            <th>Total Spent</th>
            <th>Last Purchase</th>
          </tr>
        </thead>
        <tbody>
          <% const fakeBuyers = [ { nickname: 'Jasur', totalSpent: 230000,
          lastPurchase: '2025-04-10' }, { nickname: 'ZaynLover420', totalSpent:
          185000, lastPurchase: '2025-04-08' }, { nickname: 'ChillBoi99',
          totalSpent: 160000, lastPurchase: '2025-04-06' }, { nickname:
          'Mavluda', totalSpent: 120000, lastPurchase: '2025-04-04' }, {
          nickname: 'SultanAli', totalSpent: 95000, lastPurchase: '2025-04-02' }
          ]; %> <% fakeBuyers.forEach((buyer, index) => { %>
          <tr>
            <td>
              <% if(index === 0) { %> 🥇 <% } else if(index === 1) { %> 🥈 <% }
              else if(index === 2) { %> 🥉 <% } else { %> <%= index + 1 %> <% }
              %>
            </td>
            <td><%= buyer.nickname %></td>
            <td>₩<%= buyer.totalSpent.toLocaleString() %></td>
            <td><%= buyer.lastPurchase %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>

<%- include('./includes/footer') %>

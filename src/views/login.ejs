<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <form
    class="login-container"
    action="/admin/login"
    method="POST"
    enctype="multipart/form-data"
    novalidate
  >
    <div class="login-frame">
      <div class="login-top">
        <img
          src="/img/profile.png"
          alt="Login Illustration"
          class="login-icon"
        />
        <h2>Login</h2>
      </div>

      <div class="login-input-frame">
        <label>Username *</label>
        <div class="login-input-container">
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            required
          />
        </div>
        <div class="login-input-container">
          <div class="logining-in-frame">
            <label>Password *</label>
            <div class="password-wrapper">
              <input
                type="password"
                name="memberPassword"
                class="member-password"
                placeholder="Password"
                autocomplete="member-password"
                required
              />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="eye-icon"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"
                />

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke="red"
                  d="M4 4l16 16"
                  class="eye-strike"
                />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <button class="login-btn btn" name="login" type="submit">Login</button>

      <p class="signup-text">
        Do not have an account? <a href="/admin/signup">Sign-up</a>
      </p>
    </div>
  </form>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>

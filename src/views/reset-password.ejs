<%- include('includes/header') %>

<link rel="stylesheet" href="/css/login.css" />

<body>
  <form
    class="login-container"
    action="/admin/reset-password/<%= token %>"
    method="POST"
  >
    <div class="login-frame">
      <div class="login-top">
        <img src="/img/profile.png" alt="Reset Icon" class="login-icon" />
        <h2>Set New Password</h2>
      </div>

      <!-- Message Display -->
      <% if (typeof result !== 'undefined') { %> <% if (result.error) { %>
      <p class="signup-text" style="color: red"><%= result.message %></p>
      <% } else { %>
      <p class="signup-text" style="color: yellow"><%= result.message %></p>
      <% } %> <% } %>

      <div class="login-input-frame" id="reset-form-frame">
        <div class="login-input-container">
          <label for="newPassword">New Password</label>
          <input
            type="password"
            name="newPassword"
            id="newPassword"
            placeholder="Enter your new password"
            required
          />
        </div>
      </div>

      <button class="login-btn" type="submit" id="reset-btn">Save</button>
    </div>
  </form>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const message = document.querySelector(".signup-text");
      const inputFrame = document.getElementById("reset-form-frame");
      const resetBtn = document.getElementById("reset-btn");

      if (!message) return;

      const msg = message.textContent;

      if (msg.includes("password has been changed")) {
        alert(msg);

        if (inputFrame) inputFrame.style.display = "none";
        if (resetBtn) resetBtn.style.display = "none";
      }

      if (msg.includes("invalid") || msg.includes("expired")) {
        alert(msg);
      }
    });
  </script>
</body>

<%- include('includes/footer') %>
